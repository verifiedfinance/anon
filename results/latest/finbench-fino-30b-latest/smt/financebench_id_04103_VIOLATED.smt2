(set-logic QF_NRA)
(set-option :produce-unsat-cores true)
(set-option :produce-models true)

(declare-const computed_cash_conversion_cycle Real)
(declare-const accounts_payable_end Real)
(declare-const accounts_payable_start Real)
(declare-const cost_of_revenue Real)
(declare-const inventory_end Real)
(declare-const inventory_start Real)
(declare-const receivables_end Real)
(declare-const receivables_start Real)
(declare-const revenue Real)

(assert (! (= accounts_payable_end 2854.0999999999999) :named evidence_accounts_payable_end))
(assert (! (= accounts_payable_start 2746.1999999999998) :named evidence_accounts_payable_start))
(assert (! (= cost_of_revenue 11108.4) :named evidence_cost_of_revenue))
(assert (! (= inventory_end 1559.3) :named evidence_inventory_end))
(assert (! (= inventory_start 1642.2) :named evidence_inventory_start))
(assert (! (= receivables_end 1679.7) :named evidence_receivables_end))
(assert (! (= receivables_start 1684.2) :named evidence_receivables_start))
(assert (! (= revenue 16865.200000000001) :named evidence_revenue))

(assert (! (= computed_cash_conversion_cycle (- (+ (/ (* 365 (/ (+ inventory_start inventory_end) 2)) cost_of_revenue) (/ (* 365 (/ (+ receivables_start receivables_end) 2)) revenue)) (/ (* 365 (/ (+ accounts_payable_start accounts_payable_end) 2)) (+ cost_of_revenue (- inventory_end inventory_start))))) :named formula_cash_conversion_cycle))
(assert (! (or (> cost_of_revenue 0) (< cost_of_revenue 0)) :named domain_cash_conversion_cycle_0))
(assert (! (or (> revenue 0) (< revenue 0)) :named domain_cash_conversion_cycle_1))
(assert (! (or (> (+ cost_of_revenue (- inventory_end inventory_start)) 0) (< (+ cost_of_revenue (- inventory_end inventory_start)) 0)) :named domain_cash_conversion_cycle_2))

(assert (! (<= (- computed_cash_conversion_cycle 1.3899999999999999) 0.0050000000000000001) :named claim_upper))
(assert (! (<= (- 1.3899999999999999 computed_cash_conversion_cycle) 0.0050000000000000001) :named claim_lower))

(check-sat)
(get-unsat-core)
(get-model)