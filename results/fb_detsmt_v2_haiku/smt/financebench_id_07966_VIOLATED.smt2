(assert (! (<= (- computed_capex_as_percent_of_revenue_3yr_avg 2.2000000000000002) 0.050000000000000003) :named claim_upper))
(assert (! (<= (- 2.2000000000000002 computed_capex_as_percent_of_revenue_3yr_avg) 0.050000000000000003) :named claim_lower))

(check-sat)
